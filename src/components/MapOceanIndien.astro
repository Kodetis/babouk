---
/**
 * Carte de la zone Océan Indien.
 *
 * Tout est rendu au build : les côtes deviennent des chemins SVG, les acteurs
 * des cercles déjà projetés. Le client ne reçoit ni géométrie source, ni code
 * de projection — et l'animation est intégralement en CSS, donc la carte vit
 * même si le JavaScript ne s'exécute pas.
 *
 * Accessibilité : la carte est un `role="img"` porteur d'un résumé. Tout ce
 * qu'elle montre est relu en texte dans les sections « Familles », « Territoire »
 * et « Angles morts » — elle n'est jamais le seul porteur d'une information.
 */
import mapData from "../data/map-oi.json";
import { geometryToPath, VIEW_WIDTH, VIEW_HEIGHT, project } from "../lib/projection.js";
import { mapPoints, mapPointsFins, mapArcs, coverage } from "../lib/data.js";

interface Props {
  /** `meet` montre la fenêtre entière, `slice` la remplit en rognant. */
  fit?: string;
  class?: string;
  /**
   * Voile de lisibilité interne, posé entre les terres et les acteurs.
   *
   * Un voile appliqué par-dessus toute la carte éteindrait aussi les foyers :
   * à 0,8 d'opacité, un point bleu vif devient indiscernable du fond. En le
   * glissant sous les groupes `arcs` et `nodes`, la géographie s'estompe
   * derrière le panneau de titre pendant que les acteurs — le sujet — restent
   * lumineux sur toute la largeur.
   */
  scrim?: boolean;
  /**
   * Mode carte de travail : les foyers deviennent atteignables au clavier et
   * exposent de quoi être filtrés et reliés à un panneau.
   *
   * C'est une prop et non un second fichier : la landing et `/carte` doivent
   * partager la même géographie, la même projection et les mêmes foyers. Deux
   * copies divergeraient au premier ajustement.
   *
   * Le composant n'embarque aucun script même dans ce mode — il pose des
   * attributs, la page décide quoi en faire.
   */
  interactif?: boolean;
}

const {
  fit = "xMidYMid meet",
  class: className = "",
  scrim = false,
  interactif = false,
} = Astro.props;

const countries = mapData.features.map((f) => ({
  name: f.properties.name,
  inScope: f.properties.inScope,
  d: geometryToPath(f.geometry),
}));

/** Graticule : repères d'instrument, pas décor. Méridiens tous les 20°,
    parallèles tous les 15°, plus l'équateur qui sert de ligne de foi. */
const meridians = [20, 40, 60, 80, 100, 120, 140].map((lon) => ({
  lon,
  x: project(lon, 0)[0],
}));
const parallels = [30, 15, 0, -15, -30].map((lat) => ({
  lat,
  y: project(0, lat)[1],
}));

/**
 * Arc bombé entre deux foyers. La flèche vaut 18 % de la corde, perpendiculaire
 * à celle-ci — assez pour lire une trajectoire, assez peu pour ne pas croiser
 * les terres au milieu de la fenêtre.
 */
function arcPath({ x1, y1, x2, y2 }) {
  const mx = (x1 + x2) / 2;
  const my = (y1 + y2) / 2;
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.hypot(dx, dy);
  const cx = mx - (dy / len) * len * 0.18;
  const cy = my + (dx / len) * len * 0.18;
  return `M${x1} ${y1}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2} ${y2}`;
}

const arcs = mapArcs.map((a, i) => ({
  d: arcPath(a),
  length: Math.round(a.d * 1.1),
  duration: (3.6 + (i % 5) * 0.9).toFixed(2),
  delay: ((i * 0.47) % 6).toFixed(2),
}));

/** Les cinq plus gros foyers reçoivent un anneau qui respire. Au-delà, la carte
    se met à clignoter de partout et plus rien ne ressort. */
const HALO_COUNT = 5;
const haloIds = new Set(
  [...mapPoints].sort((a, b) => b.n - a.n).slice(0, HALO_COUNT).map((p) => `${p.x}:${p.y}`)
);

/** Rayon en racine de l'effectif : c'est l'aire du disque qui doit porter le
    nombre, pas son diamètre, sinon un foyer de 63 acteurs écrase la carte. */
const radius = (n) => Math.round((4 + Math.sqrt(n) * 1.9) * 10) / 10;

/** La landing n'a qu'un jeu de foyers : elle ne cadre sur rien, la grille fine
    y serait un pâté. La carte de travail porte les deux. */
const niveaux = interactif
  ? [
      { nom: "large", points: mapPoints },
      { nom: "fin", points: mapPointsFins },
    ]
  : [{ nom: "large", points: mapPoints }];

const label =
  `Carte de la zone Océan Indien, de l'Afrique de l'Est à l'Australie. ` +
  `${coverage.onMap} des ${coverage.total} acteurs recensés y sont placés, ` +
  `regroupés en ${mapPoints.length} foyers et colorés par famille. ` +
  `Les arcs figurent le maillage régional ; ils sont illustratifs.`;
---

{/* `role="img"` rend tous ses descendants présentationnels : en mode
    interactif il rendrait les foyers définitivement inatteignables au clavier.
    La carte devient alors un groupe dont le résumé est porté par un `<desc>`
    référencé, et chaque foyer redevient un élément à part entière. */}
<svg
  class:list={["map", className]}
  viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`}
  preserveAspectRatio={fit}
  role={interactif ? "group" : "img"}
  aria-label={interactif ? "Carte interactive des acteurs" : label}
  aria-describedby={interactif ? "carte-resume" : undefined}
>
  {interactif && <desc id="carte-resume">{label}</desc>}
  <defs>
    {/* Cadre de découpe.

        En `meet`, le viewBox est ajusté puis centré dans la boîte de l'élément :
        quand le conteneur est plus haut que le rapport 1410:740, il reste des
        bandes au-dessus et au-dessous du viewBox, et ces bandes ne sont PAS
        clippées — `overflow:hidden` d'un svg racine clippe la boîte, pas le
        viewBox. La Tasmanie descend à 43,6° S alors que la fenêtre s'arrête à
        41° S : elle débordait donc de 34 unités sous le fond de mer, qui, lui,
        s'arrête à la hauteur du viewBox. D'où l'île détachée sous une arête
        horizontale nette. Les terres sont désormais coupées au cadre, comme
        l'Afrique l'est déjà au bord ouest. */}
    <clipPath id="map-frame">
      <rect width={VIEW_WIDTH} height={VIEW_HEIGHT} />
    </clipPath>
    {/* Lueur centrée sur le bassin, qui fait remonter l'océan sans introduire
        une seconde valeur de bleu : même teinte, opacité décroissante. */}
    <radialGradient id="sea-glow" cx="45%" cy="52%" r="62%">
      <stop offset="0%" stop-color="#1b2c4c" stop-opacity="0.9" />
      <stop offset="55%" stop-color="#152340" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#0c1526" stop-opacity="0" />
    </radialGradient>
    {/* Le voile s'éteint à 42 % de la largeur : au-delà, la carte est nue. */}
    <linearGradient id="scrim" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#0f1a30" stop-opacity="0.92" />
      <stop offset="22%" stop-color="#0f1a30" stop-opacity="0.86" />
      <stop offset="42%" stop-color="#0f1a30" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="arc-line" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#5b8cc9" stop-opacity="0.05" />
      <stop offset="50%" stop-color="#5b8cc9" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#5b8cc9" stop-opacity="0.05" />
    </linearGradient>
  </defs>

  {/* La mer ne bouge pas : c'est un aplat, la recadrer ne montrerait rien de
      plus et laisserait des vides aux bords pendant la transition. */}
  <rect width={VIEW_WIDTH} height={VIEW_HEIGHT} fill="var(--map-sea)" />
  <rect width={VIEW_WIDTH} height={VIEW_HEIGHT} fill="url(#sea-glow)" />

  {/* Groupe de cadrage. La page y pose `--k`, `--tx`, `--ty` ; la transition
      est en CSS. Le découpage est porté ici plutôt que sur les terres : appliqué
      au groupe, il s'exerce dans le repère non transformé, c'est-à-dire sur le
      cadre visible — sinon le zoom emporterait la découpe avec lui. */}
  <g class="cadre" clip-path="url(#map-frame)">
  <g
    class="graticule"
    stroke="rgba(120,150,200,0.10)"
    stroke-width="1"
    fill="none"
    vector-effect="non-scaling-stroke"
  >
    {meridians.map((m) => <line x1={m.x} y1="0" x2={m.x} y2={VIEW_HEIGHT} />)}
    {parallels.map((p) => (
      <line
        x1="0"
        y1={p.y}
        x2={VIEW_WIDTH}
        y2={p.y}
        stroke={p.lat === 0 ? "rgba(120,150,200,0.2)" : undefined}
      />
    ))}
  </g>

  <g class="landmass">
    {countries.map((c) => (
      <path
        d={c.d}
        fill={c.inScope ? "var(--map-land-scope)" : "var(--map-land)"}
        stroke={c.inScope ? "var(--map-stroke-scope)" : "var(--map-stroke)"}
        stroke-width={c.inScope ? 1 : 0.75}
        stroke-linejoin="round"
        {/* Le trait de côte garde son épaisseur quel que soit le cadrage. Sans
            ça, un zoom ×5 le porterait à 5 px et l'Afrique deviendrait un
            contour au feutre. */}
        vector-effect="non-scaling-stroke"
      />
    ))}
  </g>

  {scrim && (
    <rect class="scrim" width={VIEW_WIDTH} height={VIEW_HEIGHT} fill="url(#scrim)" />
  )}

  {/* Les arcs ne mesurent rien — la source ne documente aucune relation entre
      acteurs. Ils restent sur la landing, où ils sont du décor assumé et
      signalés comme tels, et disparaissent de la carte de travail, où tout ce
      qui est tracé doit pouvoir être interrogé. */}
  <g class="arcs" fill="none" hidden={interactif}>
    {!interactif && arcs.map((a) => (
      <>
        <path d={a.d} stroke="url(#arc-line)" stroke-width="1.2" />
        <path
          class="arc-pulse"
          d={a.d}
          stroke="var(--color-gold)"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-dasharray={`18 ${a.length}`}
          style={`--arc-length:${a.length + 18}px;animation-duration:${a.duration}s;animation-delay:${a.delay}s`}
        />
      </>
    ))}
  </g>

  {/* Deux jeux de foyers en mode interactif, un seul sur la landing.
      La page montre « large » au bassin et bascule sur « fin » dès qu'un pays
      est cadré : au demi-degré, La Réunion tient dans une cellule et ses 45
      acteurs — 43 adresses distinctes sur 19 communes — s'écrasent en 3
      disques. Au centième de degré, ils en font 30. */}
  {niveaux.map(({ nom, points }) => (
    <g class="nodes" data-niveau={interactif ? nom : undefined} hidden={nom === "fin"}>
      {points.map((p, i) => (
        <g
          class="node"
          data-family={p.f}
          data-count={p.n}
          data-country={p.country}
          {...(interactif && {
            role: "button",
            tabindex: "0",
            // Le filtre teste `data-fams`, jamais `data-family` : celle-ci est la
            // dominante, qui ne sert qu'à la couleur et à l'isolement de la
            // landing. Filtrer dessus éteindrait les foyers qui abritent un CERT
            // sans être à dominante CERT.
            "data-fams": p.fams,
            // Clé du panneau prérendu, préfixée par le niveau : les deux jeux
            // ont chacun leur propre indexation. Valable le temps d'un build,
            // jamais exposée dans une URL — un centroïde se déplace au moindre
            // réexport.
            "data-idx": `${nom}-${i}`,
            "aria-label": `${p.n} acteur${p.n > 1 ? "s" : ""}${p.country ? ` — ${p.country}` : ""}`,
          })}
        >
          {nom === "large" && haloIds.has(`${p.x}:${p.y}`) && (
            <circle class="node-halo" cx={p.x} cy={p.y} r={radius(p.n) * 2.4} fill={p.c} />
          )}
          <circle
            cx={p.x}
            cy={p.y}
            r={radius(p.n)}
            fill={p.c}
            fill-opacity="0.3"
            stroke={p.c}
            stroke-width="1.8"
          />
          <circle cx={p.x} cy={p.y} r={Math.max(2, radius(p.n) * 0.32)} fill={p.c} />
          {/* L'infobulle native reste au mode non interactif. En interactif,
              `aria-label` porte déjà la même phrase et le `<title>` la ferait
              annoncer deux fois. */}
          {!interactif && (
            <title>{p.n} acteur{p.n > 1 ? "s" : ""}{p.country ? ` — ${p.country}` : ""}</title>
          )}
        </g>
      ))}
    </g>
  ))}
  </g>
</svg>

<style>
  .map {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Cadrage. `--k`, `--tx`, `--ty` sont posés par la page ; à défaut, le bassin
     entier. La transition porte sur le transform, composité, jamais sur le
     viewBox qui ne s'anime pas. */
  .cadre {
    --k: 1;
    --tx: 0;
    --ty: 0;
    transform: translate(calc(var(--tx) * 1px), calc(var(--ty) * 1px)) scale(var(--k));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Contre-échelle des foyers. Le groupe de cadrage multiplie tout ce qu'il
     contient ; à ×5, un disque de 19 unités en ferait 95 et couvrirait un
     quart de la carte. Chaque foyer annule donc l'échelle autour de son propre
     centre — sa position suit le zoom, sa taille non. Les traits de côte et le
     graticule s'en sortent par `vector-effect`, qui ne s'applique pas aux
     rayons. */
  .cadre .node {
    transform: scale(calc(1 / var(--k)));
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .cadre,
    .cadre .node {
      transition: none;
    }
  }

  /* Le tiret court parcourt l'arc : c'est le seul mouvement porteur de sens de
     la carte — un échange qui circule. La longueur du trait est passée en
     custom property par élément, la seule valeur qui change d'un arc à l'autre. */
  .arc-pulse {
    stroke-dashoffset: var(--arc-length);
    animation-name: arc-travel;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    opacity: 0.75;
  }

  @keyframes arc-travel {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Isolement d'une famille. Le filtre est porté par un attribut sur un
     ancêtre : aucune classe n'est écrite sur les 55 foyers, et le rendu est
     entièrement en CSS — la légende ne fait que poser l'attribut. */
  .node {
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* États du mode interactif. Ils sont pilotés par la page : le composant pose
     les attributs, `/carte` pose `data-eteint` sur les foyers hors filtre et
     `data-actif` sur celui qui est ouvert. */
  .node[role="button"] {
    cursor: pointer;
  }
  .node[data-eteint] {
    opacity: 0.12;
  }
  /* L'anneau de focus global est un `outline`, que Safari et Firefox
     n'appliquent pas de façon fiable à un `<g>` SVG. Le contour or dessiné sur
     les cercles est le filet qui rend le parcours clavier réellement visible. */
  .node[role="button"]:focus-visible {
    outline: none;
  }
  .node[role="button"]:focus-visible circle,
  .node[data-actif] circle {
    stroke: var(--color-gold);
    stroke-width: 2.6;
  }
  :global([data-isolate]) .node {
    opacity: 0.12;
  }
  :global([data-isolate="entreprises"]) .node[data-family="entreprises"],
  :global([data-isolate="defense"]) .node[data-family="defense"],
  :global([data-isolate="formation"]) .node[data-family="formation"],
  :global([data-isolate="reseaux"]) .node[data-family="reseaux"],
  :global([data-isolate="cert"]) .node[data-family="cert"],
  :global([data-isolate="recherche"]) .node[data-family="recherche"],
  :global([data-isolate="association"]) .node[data-family="association"],
  :global([data-isolate="accompagnement"]) .node[data-family="accompagnement"] {
    opacity: 1;
  }
  :global([data-isolate]) .arcs {
    opacity: 0.25;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .node-halo {
    opacity: 0.14;
    animation: node-breathe 4.5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes node-breathe {
    0%, 100% { opacity: 0.08; transform: scale(0.9); }
    50% { opacity: 0.2; transform: scale(1.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* L'arc garde un tiret posé en milieu de course : la trajectoire reste
       lisible, elle cesse simplement de défiler. */
    .arc-pulse {
      animation: none;
      stroke-dashoffset: calc(var(--arc-length) / 2);
      opacity: 0.5;
    }
    .node-halo {
      animation: none;
      opacity: 0.14;
    }
  }
</style>
