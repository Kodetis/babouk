---
import { asset, home } from "../lib/url.js";

/**
 * Les ancres sont écrites en absolu depuis la racine du site, et non en `#…` :
 * la barre est partagée avec l'annuaire, où ces sections n'existent pas et où
 * une ancre relative ne mènerait nulle part.
 */
const annuaire = asset("annuaire/");
const links = [
  { label: "Annuaire", href: annuaire },
  { label: "Familles", href: `${home}#familles` },
  { label: "Territoire", href: `${home}#territoire` },
  { label: "Angles morts", href: `${home}#angles-morts` },
  { label: "Source", href: `${home}#source` },
];

/** L'annuaire ne se signale pas comme une destination depuis lui-même. */
const surAnnuaire = Astro.url.pathname.replace(/\/$/, "") === annuaire.replace(/\/$/, "");
---

<nav
  id="main-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href={home} class="group flex shrink-0 items-center gap-3" aria-label="Babouk — accueil">
      {/* Décoratif : le nom est écrit juste à côté, en texte. */}
      <img src={asset("logo-babouk-mark.png")} alt="" width="256" height="242" class="logo-mark h-10 shrink-0 sm:h-11" />
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-bold tracking-[0.18em] text-white">BABOUK</span>
        <span class="meta mt-1 text-white/55">Océan Indien</span>
      </span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={surAnnuaire && link.href === annuaire ? "page" : undefined}
          class:list={[
            "font-display text-xs font-medium uppercase tracking-[0.12em] transition-colors hover:text-gold",
            surAnnuaire && link.href === annuaire ? "text-gold" : "text-white/70",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={asset("acteurs.csv")} download class="btn-outline px-5 py-2 text-xs">
        Données
      </a>
    </div>

    <button
      id="menu-toggle"
      class="text-white lg:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-navy-dark/95 backdrop-blur-lg lg:hidden">
    <div class="flex flex-col gap-4 px-6 py-5">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={surAnnuaire && link.href === annuaire ? "page" : undefined}
          class:list={[
            "font-display text-sm font-medium uppercase tracking-[0.12em] transition-colors hover:text-gold",
            surAnnuaire && link.href === annuaire ? "text-gold" : "text-white/70",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={asset("acteurs.csv")} download class="btn-outline mt-1 self-start px-5 py-2 text-xs">
        Données
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("main-nav");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  // Fond de barre au-delà de 60 px de défilement. Passif : aucun style lu dans
  // le gestionnaire, donc aucun reflow synchrone.
  function onScroll() {
    if (!nav) return;
    const scrolled = window.scrollY > 60;
    nav.style.backgroundColor = scrolled ? "var(--nav-scrolled)" : "transparent";
    nav.style.backdropFilter = scrolled ? "blur(12px)" : "";
    nav.style.borderBottomColor = scrolled ? "rgba(255,255,255,0.06)" : "transparent";
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const isOpen = () => menu?.classList.contains("hidden") === false;

  function setMenu(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
  }

  toggle?.addEventListener("click", () => setMenu(!isOpen()));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });
</script>
