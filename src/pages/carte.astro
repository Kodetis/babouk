---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import MapOceanIndien from "../components/MapOceanIndien.astro";
import {
  FAMILIES,
  mapPoints,
  mapPointsFins,
  familyFacets,
  countryFacets,
  coverage,
} from "../lib/data.js";
import { cadrages } from "../lib/vues.js";
import { asset } from "../lib/url.js";

const nf = new Intl.NumberFormat("fr-FR");

/**
 * Effectifs de foyers par axe, à ne pas confondre avec les effectifs d'acteurs
 * des facettes.
 *
 * Une facette peut être vraie et ne rien allumer : « France 1 » compte un
 * acteur du recensement, qui n'est pas géolocalisé dans le cadre, donc zéro
 * foyer. Ces facettes sont marquées `facet--vide` — le style existe déjà pour
 * l'annuaire — plutôt que retirées : elles restent cliquables et la page nomme
 * alors ce qu'elle ne peut pas montrer.
 */
const foyersParFamille = new Map();
const foyersParPays = new Map();
for (const p of mapPoints) {
  for (const s of p.fams.split(" ")) {
    foyersParFamille.set(s, (foyersParFamille.get(s) ?? 0) + 1);
  }
  foyersParPays.set(p.country, (foyersParPays.get(p.country) ?? 0) + 1);
}

/** Slug -> couleur et libellé, pour les pastilles des lignes du panneau. La
    couleur ne porte jamais seule : chaque pastille est doublée de son libellé. */
const PAR_SLUG = new Map(FAMILIES.map((f) => [f.slug, f]));
const SANS_FAMILLE = { short: "Sans famille", color: "rgba(255,255,255,0.45)" };
const famille = (slug) => PAR_SLUG.get(slug) ?? SANS_FAMILLE;

/**
 * Nom du foyer. La source ne nomme pas les groupes : on prend la ville la plus
 * représentée dans la cellule, faute de quoi le pays. Un foyer d'un demi-degré
 * ne chevauche aucune frontière — une garde au build le vérifie dans data.js.
 */
function lieu(p) {
  const villes = new Map();
  for (const a of p.actors) {
    if (!a.city) continue;
    villes.set(a.city, (villes.get(a.city) ?? 0) + 1);
  }
  const top = [...villes].sort((a, b) => b[1] - a[1])[0];
  return top ? top[0] : p.country || "Lieu non nommé";
}

/** Acteurs hors carte : sans coordonnées, plus celui qui tombe hors du cadre. */
const horsCarte = coverage.unlocated + coverage.offFrame;

/** Un panneau par foyer et par niveau : les deux jeux ont leur propre
    indexation, la clé la porte. */
const niveaux = [
  { nom: "large", points: mapPoints },
  { nom: "fin", points: mapPointsFins },
];

const CONTRACT = `<!--
      THESIS: Une carte de travail, pas une illustration. On clique un foyer,
      on lit qui s'y trouve. Le filtre eteint, il ne fait pas disparaitre : la
      geographie du bassin reste lisible quel que soit le filtre actif.
      OWN-WORLD: Meme monde que la landing — fond #0f1a30, or rare, rouge
      CLUSIR structurel. La carte est partagee avec la landing par une prop,
      jamais copiee.
      STORY: Le visiteur cherche un acteur par sa localisation et le trouve en
      trois clics, panneau compris.
      FINISH: unreviewed and undocumented is unfinished
    -->`;
---

<Layout
  title="Carte — les acteurs cyber de l'océan Indien"
  description={`Les ${nf.format(coverage.onMap)} acteurs géolocalisés de la cybersécurité dans l'océan Indien, regroupés en ${mapPoints.length} foyers, filtrables par famille et par pays.`}
  contract={CONTRACT}
>
  <Navbar />

  <main id="contenu" class="pt-28 sm:pt-32">
    <header class="mx-auto max-w-7xl px-6">
      <h1 class="font-display font-bold leading-[0.95] tracking-[-0.02em]">
        <span class="block text-[clamp(2.25rem,5.5vw,3.5rem)] text-white">Le recensement,</span>
        <span class="block text-[clamp(2.25rem,5.5vw,3.5rem)] text-gold">sur la carte</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">
        {nf.format(coverage.onMap)} acteurs géolocalisés, regroupés en {mapPoints.length} foyers —
        une bonne part des fiches partagent le centroïde de leur ville, un disque vaut donc
        souvent plusieurs acteurs. Cliquez un foyer pour lire qui s'y trouve.
      </p>

      <noscript>
        <p class="panel mt-6 max-w-2xl p-5 text-sm leading-relaxed text-white/70">
          Les filtres et le panneau demandent JavaScript. La carte reste lisible telle quelle, et
          <a href={asset("annuaire/")} class="text-gold underline">l'annuaire</a> liste les
          {nf.format(coverage.total)} acteurs sans en avoir besoin.
        </p>
      </noscript>
    </header>

    {/* ============================== FILTRES ==============================
        Deux axes seulement, avec les valeurs exactes de l'annuaire — y compris
        « Sans famille » et « Sans pays », qui ne sont pas des rebuts mais 21 et
        113 acteurs que le filtre doit savoir atteindre. Pas de champ texte : la
        recherche plein texte reste à l'annuaire, la carte n'en est pas un
        second moteur. */}
    <div
      data-console
      class="sticky top-20 z-40 mt-10 border-y border-white/[0.06] bg-navy-dark/95 py-4 backdrop-blur-md"
    >
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:gap-10">
          <section aria-labelledby="titre-familles" class="min-w-0 flex-1">
            <h2 id="titre-familles" class="meta text-white/70">Famille</h2>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {familyFacets.map((f) => (
                <button
                  type="button"
                  class:list={["facet facet--chip", !foyersParFamille.get(f.slug) && "facet--vide"]}
                  data-facet="famille"
                  data-value={f.slug}
                  aria-pressed="false"
                  style={`--accent:${f.color}`}
                >
                  <span class="facet-dot" aria-hidden="true"></span>
                  <span class="text-sm">{f.label}</span>
                  <span class="readout text-xs text-white/60" data-count>{nf.format(f.count)}</span>
                </button>
              ))}
            </div>
          </section>

          <section aria-labelledby="titre-pays" class="min-w-0 flex-1">
            <h2 id="titre-pays" class="meta text-white/70">Pays</h2>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {/* Sans pastille : la pastille nomme une famille. Quatorze
                  disques blancs identiques ne nommeraient rien. */}
              {countryFacets.map((c) => (
                <button
                  type="button"
                  class:list={[
                    "facet facet--chip facet--plain",
                    !foyersParPays.get(c.slug) && "facet--vide",
                  ]}
                  data-facet="pays"
                  data-value={c.slug}
                  aria-pressed="false"
                  data-cadrage={cadrages[c.slug] ? JSON.stringify(cadrages[c.slug]) : undefined}
                >
                  <span class="text-sm">{c.label}</span>
                  <span class="readout text-xs text-white/60" data-count>{nf.format(c.count)}</span>
                </button>
              ))}
            </div>
          </section>

          <div class="flex shrink-0 items-center gap-3">
            <button
              type="button"
              id="reinitialiser"
              class="meta rounded-lg border border-white/[0.12] px-4 py-2.5 text-white/70 transition-colors hover:border-white/30 hover:text-white"
            >
              Réinitialiser
            </button>
            <a id="vers-annuaire" href={asset("annuaire/")} class="btn-outline text-xs">
              Voir dans l'annuaire
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* ========================== CARTE ET PANNEAU ========================== */}
    <div class="mx-auto mt-10 max-w-7xl px-6 pb-28">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div data-carte class="lg:col-span-8">
          <div class="panel overflow-hidden p-2 sm:p-4">
            <MapOceanIndien interactif class="carte-travail" />
          </div>

          <div id="vide" class="hidden panel mt-6 p-8 text-center">
            <p id="vide-cause" class="mx-auto max-w-lg leading-relaxed text-white/70"></p>
            <button type="button" data-reset class="btn-outline mt-6 text-xs">
              Tout réafficher
            </button>
          </div>
        </div>

        {/* Le panneau. Les 55 blocs sont rendus au build et masqués : c'est le
            modèle de l'annuaire, où le client ne fait que montrer et masquer.
            `hidden` plutôt qu'une classe, pour que les 54 panneaux fermés
            sortent aussi de l'arbre d'accessibilité — sinon le parcours clavier
            traverse 568 liens invisibles. */}
        <aside data-panneau-hote class="lg:col-span-4">
          <div class="panel flex max-h-[70dvh] flex-col overflow-hidden lg:sticky lg:top-40">
            <div id="panneau-invite" class="p-8">
              <p class="leading-relaxed text-white/70">
                Cliquez un foyer sur la carte pour lire les acteurs qui s'y trouvent.
              </p>
            </div>

            {niveaux.flatMap(({ nom, points }) => points.map((p, i) => (
              <section
                data-panneau={`${nom}-${i}`}
                hidden
                aria-label={`Acteurs du foyer de ${lieu(p)}`}
                class="flex min-h-0 flex-col"
              >
                <div class="flex items-baseline justify-between gap-4 border-b border-white/[0.08] p-6">
                  <div class="min-w-0">
                    {/* `tabindex="-1"` : le titre n'entre pas dans le parcours
                        clavier, mais peut recevoir le focus à l'ouverture pour
                        que la lecture enchaîne lieu, effectif, puis liste. */}
                    <h2
                      tabindex="-1"
                      class="truncate font-display text-lg font-semibold text-white outline-none"
                    >
                      {lieu(p)}
                    </h2>
                    <p class="meta mt-1 truncate text-white/55">{p.country || "Sans pays"}</p>
                  </div>
                  <span class="readout shrink-0 text-2xl text-white">{p.n}</span>
                </div>

                <ul class="min-h-0 flex-1 divide-y divide-white/[0.06] overflow-y-auto">
                  {p.actors.map((a) => (
                    <li data-acteur data-f={a.fams} data-c={p.country} class="px-6 py-4">
                      <div class="flex items-start gap-3">
                        <span
                          class="mt-[0.45rem] h-2 w-2 shrink-0 rounded-full"
                          style={`background:${famille(a.fams.split(" ")[0]).color}`}
                          aria-hidden="true"
                        ></span>
                        <div class="min-w-0 flex-1">
                          <p class="font-display text-sm font-semibold leading-snug text-white">
                            {a.name}
                            {/* La mention est écrite, pas seulement grisée : un
                                acteur atténué sans libellé se lit comme une
                                erreur d'affichage, et l'opacité seule ne dit
                                rien à un lecteur d'écran. */}
                            <span
                              data-mention
                              hidden
                              class="meta ml-2 align-middle text-[0.65rem] text-white/45"
                            >
                              hors filtre
                            </span>
                          </p>
                          <p class="meta mt-1 truncate text-white/50">
                            {a.fams
                              .split(" ")
                              .map((s) => famille(s).short)
                              .join(" · ")}
                            {a.city ? ` — ${a.city}` : ""}
                          </p>
                          {a.web && (
                            <a
                              href={a.web.startsWith("http") ? a.web : `https://${a.web}`}
                              rel="noopener noreferrer nofollow"
                              target="_blank"
                              class="meta mt-1.5 inline-block text-gold/80 underline decoration-gold/30 underline-offset-2 transition-colors hover:text-gold"
                            >
                              {a.web.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                            </a>
                          )}
                        </div>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            )))}

            {/* Permanent, sous le panneau quel que soit son état. Les masquer
                serait le seul vrai mensonge possible sur une page qui s'appelle
                « carte » : ils comptent dans le total et ne sont nulle part. */}
            <footer class="border-t border-white/[0.08] p-5">
              <p class="text-xs leading-relaxed text-white/55">
                <strong class="font-semibold text-white/75">{horsCarte} acteurs</strong> ne sont pas
                sur la carte — {coverage.unlocated} sans coordonnées et {coverage.offFrame} hors du
                cadre. Ils sont dans
                {" "}<a href={asset("annuaire/")} class="text-gold underline">l'annuaire</a>.
              </p>
            </footer>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  /**
   * État de la carte de travail.
   *
   * Deux axes, ceux de l'annuaire, amputés de la recherche plein texte : la
   * carte n'est pas un second moteur. Le contrat d'URL est repris tel quel pour
   * qu'un lien passe d'un écran à l'autre sans traduction — `famille` porte un
   * slug, `pays` porte le **libellé brut accentué**, parce que `countryFacets`
   * pose `slug: c.country`. Écrire `?pays=maurice` en minuscules serait rejeté
   * par la validation, ici comme dans l'annuaire.
   */
  const etat: { famille: string | null; pays: string | null } = {
    famille: null,
    pays: null,
  };

  const carte = document.querySelector<HTMLElement>("[data-carte]");
  const boutons = Array.from(document.querySelectorAll<HTMLElement>("[data-facet]"));
  const hote = document.querySelector<HTMLElement>("[data-panneau-hote]");
  const invite = document.querySelector<HTMLElement>("#panneau-invite");
  const panneaux = new Map(
    Array.from(document.querySelectorAll<HTMLElement>("[data-panneau]"))
      .map((s) => [s.dataset.panneau ?? "", s])
  );

  /**
   * Deux jeux de foyers, un seul visible.
   *
   * « large » agrège au demi-degré : c'est la lecture du bassin, qui couvre
   * 148° de longitude. « fin » agrège au centième : c'est la seule qui montre
   * quelque chose à l'échelle d'une île — La Réunion mesure moins d'un
   * demi-degré, ses 45 acteurs y font 3 disques au lieu de 30.
   *
   * On bascule sur « fin » dès qu'un pays est cadré, parce que c'est là que la
   * place existe pour les distinguer.
   */
  const groupes = new Map(
    Array.from(document.querySelectorAll<SVGGElement>(".nodes[data-niveau]"))
      .map((g) => [g.dataset.niveau ?? "", g])
  );
  let niveau: "large" | "fin" = "large";
  const foyersVisibles = () =>
    Array.from(groupes.get(niveau)?.querySelectorAll<SVGGElement>(".node") ?? []);
  const vide = document.querySelector<HTMLElement>("#vide");
  const videCause = document.querySelector<HTMLElement>("#vide-cause");
  const versAnnuaire = document.querySelector<HTMLAnchorElement>("#vers-annuaire");

  if (carte && hote && versAnnuaire) {
    /** Clé du foyer ouvert (`large-12`, `fin-40`), ou `null`. C'est un état
        d'écran : jamais dans l'URL, car l'identifiant d'un foyer est un
        centroïde recalculé à chaque export. */
    let ouvert: string | null = null;

    const libelle = (axe: string, valeur: string) => {
      const b = boutons.find((x) => x.dataset.facet === axe && (x.dataset.value ?? "") === valeur);
      return b?.querySelector("span:not(.facet-dot):not([data-count])")?.textContent?.trim() ?? valeur;
    };

    /* ------------------------------------------------------------------ URL */

    function ecrireUrl() {
      const p = new URLSearchParams();
      if (etat.famille !== null) p.set("famille", etat.famille);
      if (etat.pays !== null) p.set("pays", etat.pays);
      const suffixe = p.toString();
      history.replaceState(null, "", suffixe ? `?${suffixe}` : location.pathname);
    }

    function lireUrl() {
      const p = new URLSearchParams(location.search);
      etat.famille = p.has("famille") ? p.get("famille") : null;
      etat.pays = p.has("pays") ? p.get("pays") : null;
      // Une valeur inconnue ne doit pas éteindre la carte en silence : elle est
      // ignorée, comme le fait déjà l'annuaire.
      for (const axe of ["famille", "pays"] as const) {
        const v = etat[axe];
        if (v !== null && !boutons.some((b) => b.dataset.facet === axe && (b.dataset.value ?? "") === v)) {
          etat[axe] = null;
        }
      }
    }

    function refletFacettes() {
      for (const b of boutons) {
        const axe = b.dataset.facet as "famille" | "pays";
        b.setAttribute("aria-pressed", String(etat[axe] === (b.dataset.value ?? "")));
      }
    }

    /* -------------------------------------------------------------- filtrage */

    const passe = (fams: string, pays: string) =>
      (etat.famille === null || fams.split(" ").includes(etat.famille)) &&
      (etat.pays === null || pays === etat.pays);

    /**
     * Marque les lignes du panneau ouvert que le filtre courant exclut.
     *
     * Appelé depuis `appliquer()` et non depuis le seul gestionnaire de clic :
     * si l'utilisateur change de filtre panneau ouvert, un marquage figé
     * ferait mentir l'écran.
     */
    function refletPanneau() {
      const section = ouvert === null ? null : panneaux.get(ouvert);
      if (!section) return;
      const actif = etat.famille !== null || etat.pays !== null;
      for (const li of section.querySelectorAll<HTMLElement>("[data-acteur]")) {
        const hors = actif && !passe(li.dataset.f ?? "", li.dataset.c ?? "");
        li.toggleAttribute("data-hors-filtre", hors);
        li.querySelector("[data-mention]")?.toggleAttribute("hidden", !hors);
      }
    }

    function appliquer() {
      // Le cadrage d'abord : il choisit le niveau, donc les foyers à filtrer.
      cadrer();

      let visibles = 0;
      for (const foyer of foyersVisibles()) {
        const ok = passe(foyer.dataset.fams ?? "", foyer.dataset.country ?? "");
        foyer.toggleAttribute("data-eteint", !ok);
        if (ok) visibles++;
      }

      const actif = etat.famille !== null || etat.pays !== null;
      carte.toggleAttribute("data-carte-filtre", actif);

      // Zéro foyer retenu : nommer la contrainte plutôt que laisser une carte
      // éteinte sans explication.
      if (vide && videCause) {
        vide.classList.toggle("hidden", visibles > 0);
        if (visibles === 0) {
          const parts: string[] = [];
          if (etat.famille !== null) parts.push(libelle("famille", etat.famille));
          if (etat.pays !== null) parts.push(libelle("pays", etat.pays));
          videCause.textContent =
            parts.length > 1
              ? `Aucun foyer ne réunit ${parts[0]} et ${parts[1]}.`
              : `Aucun foyer géolocalisé pour ${parts[0]}.`;
        }
      }

      // Le pont d'état : le bouton emporte le filtre courant vers l'annuaire.
      const p = new URLSearchParams();
      if (etat.famille !== null) p.set("famille", etat.famille);
      if (etat.pays !== null) p.set("pays", etat.pays);
      const base = versAnnuaire.dataset.base ?? versAnnuaire.getAttribute("href") ?? "";
      versAnnuaire.dataset.base = base;
      versAnnuaire.href = p.toString() ? `${base}?${p}` : base;

      refletFacettes();
      refletPanneau();
      ecrireUrl();
    }

    /**
     * Recadrage sur le pays filtré.
     *
     * Le zoom suit le filtre au lieu d'être un contrôle de plus : cliquer
     * « Maurice » désigne déjà une région, recadrer dessus est la conséquence
     * de ce clic. Sans filtre pays, le bassin entier.
     *
     * Il ne sépare pas les acteurs co-localisés — ils partagent des centroïdes
     * de ville, aucun zoom n'y changera rien. C'est le panneau qui répond à
     * « qui est là » ; le recadrage ne fait que rendre la région lisible.
     */
    function cadrer() {
      const g = document.querySelector<SVGGElement>(".cadre");
      if (!g) return;
      const b = etat.pays === null ? null : boutons.find(
        (x) => x.dataset.facet === "pays" && (x.dataset.value ?? "") === etat.pays
      );
      // Un pays sans foyer géolocalisé n'a pas de cadrage : on reste au bassin
      // entier plutôt que de zoomer sur du vide.
      const c = b?.dataset.cadrage ? JSON.parse(b.dataset.cadrage) : null;
      const { k, tx, ty } = c ?? { k: 1, tx: 0, ty: 0 };
      g.style.setProperty("--k", String(k));
      g.style.setProperty("--tx", String(tx));
      g.style.setProperty("--ty", String(ty));

      // Le niveau suit le cadrage : la grille fine n'a de sens que là où il y a
      // la place de séparer les foyers.
      const voulu = c ? "fin" : "large";
      if (voulu === niveau) return;
      // Le panneau ouvert appartient au niveau qu'on quitte : sa clé n'existe
      // plus dans le jeu affiché, on referme plutôt que de laisser un panneau
      // sans foyer correspondant.
      fermer();
      niveau = voulu;
      for (const [nom, groupe] of groupes) groupe.toggleAttribute("hidden", nom !== niveau);
    }

    /* -------------------------------------------------------------- panneau */

    function fermer(rendreFocus = false) {
      if (ouvert === null) return;
      const precedent = document.querySelector<SVGGElement>(`.node[data-idx="${ouvert}"]`);
      panneaux.get(ouvert)!.hidden = true;
      precedent?.removeAttribute("data-actif");
      ouvert = null;
      invite?.removeAttribute("hidden");
      hote.removeAttribute("data-ouvert");
      if (rendreFocus) precedent?.focus();
    }

    function ouvrir(foyer: SVGGElement) {
      const cle = foyer.dataset.idx ?? "";
      const section = panneaux.get(cle);
      if (!section) return;
      if (ouvert !== null) panneaux.get(ouvert)!.hidden = true;

      for (const actif of document.querySelectorAll(".node[data-actif]")) {
        actif.removeAttribute("data-actif");
      }
      foyer.setAttribute("data-actif", "");
      invite?.setAttribute("hidden", "");
      section.hidden = false;
      hote.setAttribute("data-ouvert", "");
      ouvert = cle;

      refletPanneau();
      // Le focus part sur le titre : le lecteur d'écran enchaîne lieu, effectif
      // puis liste, au lieu de reprendre au début du document.
      section.querySelector<HTMLElement>("h2")?.focus();
    }

    /* -------------------------------------------------------------- écoutes */

    for (const b of boutons) {
      b.addEventListener("click", () => {
        const axe = b.dataset.facet as "famille" | "pays";
        const v = b.dataset.value ?? "";
        // Second clic sur la même facette : relâchement. Sans ça, un filtre posé
        // par erreur ne se retire qu'en passant par « Réinitialiser ».
        etat[axe] = etat[axe] === v ? null : v;
        appliquer();
      });
    }

    for (const reset of document.querySelectorAll("#reinitialiser, [data-reset]")) {
      reset.addEventListener("click", () => {
        etat.famille = null;
        etat.pays = null;
        appliquer();
      });
    }

    // Délégation sur la carte entière plutôt que sur un groupe de foyers : il y
    // en a deux, et celui qui écoute doit rester le même quand on bascule.
    const svg = carte.querySelector("svg");
    svg?.addEventListener("click", (e) => {
      const foyer = (e.target as Element).closest<SVGGElement>(".node[role='button']");
      if (foyer) ouvrir(foyer);
    });
    svg?.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== "Enter" && ev.key !== " ") return;
      const foyer = (ev.target as Element).closest<SVGGElement>(".node[role='button']");
      if (!foyer) return;
      // Sans ça, l'Espace fait défiler la page sous le panneau qui s'ouvre.
      ev.preventDefault();
      ouvrir(foyer);
    });

    document.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape") fermer(true);
    });

    window.addEventListener("popstate", () => {
      lireUrl();
      appliquer();
    });

    lireUrl();
    appliquer();
  }
</script>

<style>
  /* La carte occupe son cadre : c'est l'instrument de la page, pas une
     vignette. Le rapport est celui du viewBox, la hauteur suit. */
  .carte-travail {
    width: 100%;
    height: auto;
    aspect-ratio: 1410 / 740;
  }

  /* Les facettes de l'annuaire sont une colonne ; ici elles forment une barre.
     Même composant visuel, disposition en ligne. */
  .facet--chip {
    display: inline-grid;
    grid-template-columns: auto auto auto;
    gap: 0.5rem;
    align-items: center;
    width: auto;
    padding-inline: 0.7rem;
  }
  .facet--chip.facet--plain {
    grid-template-columns: auto auto;
  }

  /* Une ligne d'acteur que le filtre courant exclut reste lisible mais se
     retire : le panneau répond à une question de lieu, pas de filtre, et
     masquer ces lignes ferait mentir l'effectif affiché en tête. */
  [data-acteur][data-hors-filtre] {
    opacity: 0.4;
  }

  /* Sous `lg`, le panneau quitte la colonne et devient une feuille ancrée en
     bas d'écran : sur un téléphone, une colonne de droite passerait sous la
     carte et personne ne la verrait. */
  @media (max-width: 1023px) {
    [data-panneau-hote] {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 45;
      transform: translateY(101%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      padding: 0 0.75rem 0.75rem;
    }
    [data-panneau-hote][data-ouvert] {
      transform: translateY(0);
    }
    [data-panneau-hote] > .panel {
      max-height: 48dvh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-panneau-hote] {
      transition: none;
    }
  }
</style>
